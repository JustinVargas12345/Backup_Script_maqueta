## Archivo de ejemplo de variables de entorno para ejecutar el contenedor de backup o CLI local.
## NO COMMITS de secretos reales. Usa estos nombres como plantillas para tu CI/deploy.

# Token de notificación (si usas método de autenticación notify con env)
# Ejemplo: export NOTIFY_SECRET='s3cr3t'
NOTIFY_SECRET=

# PostgreSQL: recomendado usar PGPASSWORD en lugar de pasar --password en CLI
# export PGPASSWORD='tu_contraseña_pg'
PGPASSWORD=

# MySQL: MYSQL_PWD puede ser usado por algunos clientes; prefiere manejo seguro en tu runtime
MYSQL_PWD=

# Otros secretos usados por tu entorno
