## Example environment file for running the backup container or local CLI.
## DO NOT commit real secrets. Use these names as templates for your CI/deploy.

# Notify token (if using notify auth method with env)
# Example: export NOTIFY_SECRET='s3cr3t'
NOTIFY_SECRET=

# PostgreSQL: recommended to use PGPASSWORD instead of passing --password on CLI
# export PGPASSWORD='your_pg_password'
PGPASSWORD=

# MySQL: MYSQL_PWD can be used by some clients; prefer secure handling in your runtime
MYSQL_PWD=

# Any other secrets used by your environment
